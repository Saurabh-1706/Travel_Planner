# Copy this file to .env.local and fill in real values for local development.
# .env.local is gitignored and never committed.

# Required by NextAuth. Must match the URL the app is actually served on.
# If this is missing/wrong, the client-side session fetch to /api/auth/session
# can fail with a NextAuth CLIENT_FETCH_ERROR ("Unexpected token '<' ... not valid JSON").
NEXTAUTH_URL=http://localhost:3000

# A random secret used to sign/encrypt NextAuth session tokens.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-random-secret

# Google OAuth credentials (from Google Cloud Console -> APIs & Services -> Credentials).
# Leave blank to disable "Sign in with Google" during local development.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
